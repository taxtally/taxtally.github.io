---
import { TRANSLATIONS } from '../i18n/translations';
import type { SupportedLocale } from '../types/tax';

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const t = TRANSLATIONS[currentLocale] || TRANSLATIONS.en;
---

<section class="w-full max-w-4xl mx-auto py-12 px-4 sm:px-6">
  <div class="text-center mb-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      {t.faqTitle}
    </h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
      {t.faqSubtitle}
    </p>
  </div>

  <div class="space-y-4">
    {
      t.faqs.map((faq, index) => (
        <details
          class="group rounded-2xl bg-white dark:bg-[#092328] border border-slate-200 dark:border-[#12544F] p-5 shadow-xs transition-all duration-200 open:ring-1 open:ring-[#2A835F]/40"
          open={index === 0}
        >
          <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-slate-800 dark:text-slate-100 cursor-pointer list-none select-none">
            <span class="pr-4">{faq.q}</span>
            <div class="w-7 h-7 rounded-full bg-slate-100 dark:bg-[#12544F]/40 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-4 h-4 text-slate-500 dark:text-[#8BBB92]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <p class="text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-300 mt-3 pt-3 border-t border-slate-100 dark:border-[#12544F]/60">
            {faq.a}
          </p>
        </details>
      ))
    }
  </div>
</section>
