---
import { LOCALES } from '../i18n/translations';
import type { SupportedLocale } from '../types/tax';

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const current = LOCALES[currentLocale] || LOCALES.en;

const getLocaleUrl = (code: SupportedLocale) => {
  return code === 'en' ? '/' : `/${code}/`;
};
---

<div class="relative inline-block text-left" id="language-picker-container">
  <button
    id="language-menu-btn"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="language-dropdown"
    aria-label="Select Language"
    title={`Current Language: ${current.name}`}
    class="inline-flex items-center justify-center gap-1.5 p-2 lg:px-3 lg:py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-[#8BBB92] hover:text-[#092328] dark:hover:text-white bg-slate-100/80 dark:bg-[#12544F]/40 border border-slate-200/80 dark:border-[#12544F] hover:bg-slate-200/60 dark:hover:bg-[#12544F]/70 transition-colors cursor-pointer"
  >
    <span class="text-sm">{current.flag}</span>
    <span class="hidden lg:inline">{current.name}</span>
    <svg class="w-3.5 h-3.5 text-slate-400 dark:text-[#8BBB92]/70 hidden lg:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id="language-dropdown"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="language-menu-btn"
    class="hidden absolute right-0 mt-2 w-36 rounded-xl bg-white dark:bg-[#092328] border border-slate-200 dark:border-[#12544F] shadow-lg py-1.5 z-50 text-xs focus:outline-hidden"
  >
    {
      Object.values(LOCALES).map((loc) => (
        <a
          href={getLocaleUrl(loc.code)}
          role="menuitem"
          class={`flex items-center justify-between px-3 py-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-[#12544F]/50 transition-colors ${
            loc.code === currentLocale ? 'font-bold text-[#2A835F] dark:text-[#8BBB92] bg-[#8BBB92]/10 dark:bg-[#12544F]/60' : ''
          }`}
        >
          <span class="flex items-center gap-2">
            <span>{loc.flag}</span>
            <span>{loc.name}</span>
          </span>
          {loc.code === currentLocale && (
            <svg class="w-3.5 h-3.5 text-[#2A835F] dark:text-[#8BBB92]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  function setupLanguagePicker() {
    const btn = document.getElementById('language-menu-btn');
    const dropdown = document.getElementById('language-dropdown');
    if (!btn || !dropdown) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
      const isExpanded = !dropdown.classList.contains('hidden');
      btn.setAttribute('aria-expanded', String(isExpanded));
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target) && e.target !== btn) {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  setupLanguagePicker();
  document.addEventListener('astro:after-swap', setupLanguagePicker);
</script>
