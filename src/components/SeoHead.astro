---
import { TRANSLATIONS, LOCALES } from '../i18n/translations';
import type { SupportedLocale } from '../types/tax';

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;
const t = TRANSLATIONS[currentLocale] || TRANSLATIONS.en;
const currentLoc = LOCALES[currentLocale] || LOCALES.en;

const siteUrl = 'https://taxtally.github.io';
const canonicalUrl = currentLocale === 'en' ? `${siteUrl}/` : `${siteUrl}/${currentLocale}/`;
const ogImageUrl = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';
const ogImageAlt = 'TaxTally - Free Private Income Tax & Salary Calculator';

// 1. WebSite Schema with Organization Publisher
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'TaxTally',
  alternateName: 'TaxTally Private Tax Engine',
  url: siteUrl,
  description: t.metaDescription,
  inLanguage: currentLocale,
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'TaxTally',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: 1200,
      height: 630,
    },
  },
};

// 2. WebApplication Schema
const webApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${canonicalUrl}#webapp`,
  name: t.siteTitle,
  alternateName: 'TaxTally Income & Salary Tax Calculator',
  url: canonicalUrl,
  image: ogImageUrl,
  applicationCategory: 'FinanceApplication',
  applicationSubCategory: 'Tax Calculator',
  operatingSystem: 'All modern web browsers (Chrome, Safari, Firefox, Edge)',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  featureList: [
    '100% Client-Side Privacy Guarantee',
    'Instant Progressive Tax Bracket Computation',
    'Multi-country Presets (US, UK, Canada, Australia, Germany)',
    'Paycheck Period Schedule (Annual, Monthly, Bi-Weekly, Hourly)',
    'Standard and Custom Deduction Support',
    'Visual Income Distribution Progress Bar',
    'One-click PDF / Print Export',
  ],
  inLanguage: currentLocale,
};

// 3. BreadcrumbList Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement:
    currentLocale === 'en'
      ? [
          {
            '@type': 'ListItem',
            position: 1,
            name: t.breadcrumbHome,
            item: `${siteUrl}/`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: t.breadcrumbCalculator,
            item: `${siteUrl}/`,
          },
        ]
      : [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: `${siteUrl}/`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: currentLoc.name,
            item: canonicalUrl,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: t.breadcrumbCalculator,
            item: canonicalUrl,
          },
        ],
};

// 4. FAQPage Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<!-- Core Meta Tags -->
<title>{t.siteTitle}</title>
<meta name="description" content={t.metaDescription} />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="keywords" content="tax calculator, salary calculator, income tax calculator, take home pay, paycheck calculator, progressive tax brackets, standard deduction, tax tally" />
<meta name="author" content="TaxTally" />
<link rel="canonical" href={canonicalUrl} />

<!-- Mobile & PWA Theme Metadata -->
<meta name="theme-color" content="#12544F" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#092328" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- Multilingual Alternate Links (hreflang) -->
{
  Object.values(LOCALES).map((loc) => {
    const locUrl = loc.code === 'en' ? `${siteUrl}/` : `${siteUrl}/${loc.code}/`;
    return <link rel="alternate" hreflang={loc.code} href={locUrl} />;
  })
}
<link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

<!-- OpenGraph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="TaxTally" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={t.siteTitle} />
<meta property="og:description" content={t.metaDescription} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={currentLoc.ogLocale} />
{
  Object.values(LOCALES)
    .filter((loc) => loc.code !== currentLocale)
    .map((loc) => <meta property="og:locale:alternate" content={loc.ogLocale} />)
}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={t.siteTitle} />
<meta name="twitter:description" content={t.metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Strict Structured Data (JSON-LD) Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
