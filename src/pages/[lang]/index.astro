---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TaxCalculator } from '../../components/TaxCalculator';
import type { SupportedLocale } from '../../types/tax';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'ja' } },
  ];
}

const { lang } = Astro.params;
const currentLocale = (lang as SupportedLocale) || 'en';
---

<BaseLayout currentLocale={currentLocale}>
  <TaxCalculator client:load currentLocale={currentLocale} />
</BaseLayout>
